{
  "name": "opensearch-2-x-to-3-0",
  "version": "0.2.0",
  "description": "Migrate OpenSearch application code and checked-in config from 2.x to 3.0",
  "packageManager": "npm@10.x",
  "type": "module",
  "scripts": {
    "test": "npm run test:path-hierarchy && npm run test:query-group && npm run test:compatibility && npm run test:knn && npm run test:mmap && npm run test:thread-pool && npm run test:bulk-batch-size && npm run test:discover && npm run test:sql && npm run test:bm25 && npm run test:nmslib && npm run test:locale && npm run test:httpclient5 && npm run test:jpms && npm run test:ml && npm run test:non-inclusive && npm run test:plugin-module && npm run test:transport-nio && npm run test:indexing-buffer && npm run test:empty-array && npm run test:jdk21 && npm run test:system-index && npm run test:dashboards",
    "test:path-hierarchy": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/codemod.ts ./tests/path-hierarchy",
    "test:query-group": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/query-group-to-workload-group.ts ./tests/query-group-to-workload-group",
    "test:compatibility": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/remove-compatibility-override.ts ./tests/remove-compatibility-override",
    "test:knn": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/remove-deprecated-knn-settings.ts ./tests/remove-deprecated-knn-settings",
    "test:mmap": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/remove-mmap-extensions.ts ./tests/remove-mmap-extensions",
    "test:thread-pool": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/remove-thread-pool-test-settings.ts ./tests/remove-thread-pool-test-settings",
    "test:bulk-batch-size": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/remove-bulk-batch-size.ts ./tests/remove-bulk-batch-size",
    "test:discover": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/remove-discover-new-experience.ts ./tests/remove-discover-new-experience",
    "test:sql": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/sql-plugin-removals.ts ./tests/sql-plugin-removals",
    "test:bm25": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/legacy-bm25-to-bm25.ts ./tests/legacy-bm25-to-bm25",
    "test:nmslib": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/nmslib-engine-to-faiss.ts ./tests/nmslib-engine-to-faiss",
    "test:locale": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/locale-compat-to-cldr.ts ./tests/locale-compat-to-cldr",
    "test:httpclient5": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/httpclient5-imports.ts ./tests/httpclient5-imports",
    "test:jpms": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/jpms-client-package.ts ./tests/jpms-client-package",
    "test:ml": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/ml-commons.ts ./tests/ml-commons",
    "test:non-inclusive": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/non-inclusive-terms.ts ./tests/non-inclusive-terms",
    "test:plugin-module": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/plugin-to-module.ts ./tests/plugin-to-module",
    "test:transport-nio": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/remove-transport-nio.ts ./tests/remove-transport-nio",
    "test:indexing-buffer": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/swap-indexing-buffer-fields.ts ./tests/swap-indexing-buffer-fields",
    "test:empty-array": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/empty-array-string-to-array.ts ./tests/empty-array-string-to-array",
    "test:jdk21": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/jdk21-runtime.ts ./tests/jdk21-runtime",
    "test:system-index": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/system-index-paths.ts ./tests/system-index-paths",
    "test:dashboards": "npx --yes codemod@1.18.7 jssg test -l typescript ./scripts/dashboards-migrations.ts ./tests/dashboards-migrations",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemod.com/jssg-types": "latest",
    "typescript": "latest"
  }
}
